# Public Supabase project values. Use separate projects per environment.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Server-only values. Never prefix with NEXT_PUBLIC_ or expose to browser/logs.
SUPABASE_SERVICE_ROLE_KEY=replace-only-in-approved-server-runtime
OPENAI_API_KEY=replace-only-when-AI-gate-is-approved
APP_ENV=local
