{
  "name": "wellb-openlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=24 <25", "pnpm": ">=11 <12"},
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:contracts": "python scripts/qa/repo_contract_qa.py",
    "qa": "pnpm qa:contracts && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "eslint-config-next": "16.3.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
